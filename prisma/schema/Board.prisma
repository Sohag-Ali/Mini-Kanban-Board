model Board {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User          @relation("BoardOwner", fields: [ownerId], references: [id])
  members BoardMember[]
  columns Column[]

  @@index([ownerId])
}